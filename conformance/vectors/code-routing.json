{
  "table": "code-routing",
  "cases": [
    {"name":"upper case","input":{"code":"K7MQ2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"lower case","input":{"code":"k7mq2x","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"mixed case","input":{"code":"k7Mq2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"grouped with a hyphen","input":{"code":"K7M-Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"grouped with a space","input":{"code":"k7m q2x","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"surrounding whitespace","input":{"code":"  K7MQ2X \n","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"tab and carriage return","input":{"code":"\tK7M\rQ2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"no-break space","input":{"code":"K7M\u00a0Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"narrow no-break and figure spaces","input":{"code":"K7\u202fMQ\u20072X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"en dash","input":{"code":"K7M\u2013Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"em dash","input":{"code":"K7M\u2014Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"minus sign","input":{"code":"K7M\u2212Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"non-breaking hyphen","input":{"code":"K7M\u2011Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"several separators","input":{"code":"- K7 -- MQ - 2X -","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"K7MQ2X","relay":"c"}},
    {"name":"first symbol 2 routes to a","input":{"code":"2ABCDE","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"2ABCDE","relay":"a"}},
    {"name":"first symbol 8 routes to a","input":{"code":"823456","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"823456","relay":"a"}},
    {"name":"first symbol 9 routes to b","input":{"code":"923456","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"923456","relay":"b"}},
    {"name":"first symbol F routes to b","input":{"code":"F23456","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"F23456","relay":"b"}},
    {"name":"first symbol G routes to c","input":{"code":"G23456","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"G23456","relay":"c"}},
    {"name":"first symbol P routes to c","input":{"code":"PQRSTU","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"PQRSTU","relay":"c"}},
    {"name":"first symbol Q: no relay owns it","input":{"code":"Q23456","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"Q23456","relay":null}},
    {"name":"first symbol Z: no relay owns it","input":{"code":"ZZZZZZ","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"ZZZZZZ","relay":null}},
    {"name":"U V W X Y are symbols","input":{"code":"UVWXY2","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"code":"UVWXY2","relay":null}},
    {"name":"five symbols","input":{"code":"K7MQ2","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"seven symbols","input":{"code":"K7MQ2XA","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"empty","input":{"code":"","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"only separators","input":{"code":" - - ","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"zero is not a symbol","input":{"code":"K7MQ20","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"letter O is not a symbol","input":{"code":"K7MQ2O","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"one is not a symbol","input":{"code":"K7MQ21","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"letter I is not a symbol","input":{"code":"K7MQ2I","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"lower-case l is not a symbol","input":{"code":"k7mq2l","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"underscore is not stripped","input":{"code":"K7M_Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"dot is not stripped","input":{"code":"K7M.Q2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"non-ASCII letter","input":{"code":"K7MQ2\u00c9","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"full-width letter","input":{"code":"\uff2b7MQ2X","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"}]},"expect":{"error":"invalid_code"}},
    {"name":"self-hosted relay owns every symbol","input":{"code":"Q2X7MK","relays":[{"id":"local","prefixes":"23456789ABCDEFGHJKMNPQRSTUVWXYZ"}]},"expect":{"code":"Q2X7MK","relay":"local"}},
    {"name":"a symbol no relay owned, now owned by a new relay","input":{"code":"Q2X7MK","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"GHJKMNP"},{"id":"d","prefixes":"QRSTUVWXYZ"}]},"expect":{"code":"Q2X7MK","relay":"d"}},
    {"name":"ownership after a move","input":{"code":"G2X7MK","relays":[{"id":"a","prefixes":"2345678"},{"id":"b","prefixes":"9ABCDEF"},{"id":"c","prefixes":"HJKMNP"},{"id":"d","prefixes":"G"}]},"expect":{"code":"G2X7MK","relay":"d"}}
  ]
}
